#!/bin/sh

set -e

## Danilinux 2.2 — live-build configuration (Debian 13 "trixie" base)

lb config noauto \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --bootappend-live "boot=live components hostname=danilinux username=danilinux quiet splash" \
    --bootloader grub \
    --debian-installer none \
    --iso-application "Danilinux" \
    --iso-publisher "Danilinux; https://danilinux.local" \
    --iso-volume "Danilinux 2.2" \
    --image-name danilinux-2.2-amd64 \
    --cache true \
    --debug false \
    --verbose false \
    "$@"
