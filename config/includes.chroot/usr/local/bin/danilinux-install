#!/bin/sh
## Danilinux 2.2 - "Install Danilinux" launcher (live session)
## Based on calamares-settings-debian's launcher (GPL-2.0+)

# stale fstab left by live-build confuses the partitioner - move it away
sudo -n mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null

# let root connect to the X server
xhost +si:localuser:root >/dev/null 2>&1

# sudo first (the live user has NOPASSWD sudo - deterministic, no prompts),
# pkexec as a fallback for environments without sudo access
if sudo -n true 2>/dev/null; then
    sudo -n calamares
else
    pkexec calamares
fi
rc=$?

xhost -si:localuser:root >/dev/null 2>&1
sudo -n mv /etc/fstab.orig.calamares /etc/fstab 2>/dev/null
exit $rc
